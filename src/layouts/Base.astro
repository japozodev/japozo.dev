---
import '@fontsource-variable/fira-code/wght.css';
import '../styles/global.css';
import '../styles/cube.css';
import '../styles/swipe.css';
import type { Lang } from '../data/site';
import { SITE, SOCIAL } from '../data/site';
import { DEFAULT_THEME, THEME_KEY } from '../data/themes';
import { LANGS, pathFor, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** título propio (páginas que no son la portada, como la 404) */
  title?: string;
  noindex?: boolean;
}

const { lang, title, noindex = false } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(pathFor(lang), Astro.site);
// imagen social de 1200x630, generada en src/lib/og.ts
const ogUrl = new URL(lang === 'es' ? '/og.png' : '/en/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'José Antonio Pozo',
  alternateName: SITE.name,
  jobTitle: 'Web Developer',
  url: SITE.domain,
  address: { '@type': 'PostalAddress', addressLocality: 'Gijón', addressCountry: 'ES' },
  sameAs: [SOCIAL.github, SOCIAL.linkedin],
};
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={SITE.name} />
    {/* La 404 no es una página canónica: sin canonical ni alternativas de idioma */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#121416" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/HackNerdFont-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HackNerdFont-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Aplica el tema antes de pintar para evitar el parpadeo -->
    <script is:inline define:vars={{ THEME_KEY }}>
      const root = document.documentElement;
      root.classList.add('js');
      // cubo de workspaces en escritorio, caras deslizables en el resto (ver scripts/workspaces.ts)
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        root.classList.add(matchMedia('(min-width: 1100px) and (min-height: 560px)').matches ? 'cube' : 'swipe');
      }
      let theme = null;
      try { theme = localStorage.getItem(THEME_KEY); } catch {}
      if (theme) root.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
