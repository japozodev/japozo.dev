---
import '../styles/global.css';
import type { Lang } from '../data/site';
import { SITE, SOCIAL } from '../data/site';
import { DEFAULT_THEME, THEME_KEY } from '../data/themes';
import { LANGS, pathFor, useTranslations } from '../i18n/ui';
import profile from '../assets/profile.jpg';
import { getImage } from 'astro:assets';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(pathFor(lang), Astro.site);
// TODO: sustituir por una imagen social propia de 1200x630
const ogImage = await getImage({ src: profile, format: 'jpg', width: 460 });
const ogUrl = new URL(ogImage.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'José Antonio Pozo',
  alternateName: SITE.name,
  jobTitle: 'Frontend Developer',
  url: SITE.domain,
  address: { '@type': 'PostalAddress', addressLocality: 'Gijón', addressCountry: 'ES' },
  sameAs: [SOCIAL.github, SOCIAL.linkedin],
};
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#121416" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/HackNerdFont-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HackNerdFont-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Aplica el tema antes de pintar para evitar el parpadeo -->
    <script is:inline define:vars={{ THEME_KEY }}>
      const root = document.documentElement;
      root.classList.add('js');
      let theme = null;
      try { theme = localStorage.getItem(THEME_KEY); } catch {}
      if (!theme && matchMedia('(prefers-color-scheme: light)').matches) theme = 'latte';
      if (theme) root.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
