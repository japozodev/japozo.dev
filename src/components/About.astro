---
import { Image } from 'astro:assets';
import type { Lang } from '../data/site';
import { GITGRAPH, STACK } from '../data/site';
import { useTranslations } from '../i18n/ui';
import profile from '../assets/profile.jpg';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// el mismo log con ramas que la base del cubo. En móvil los mensajes largos saltan
// de línea: las ramas que siguen hacia abajo se alargan con '|' (g-cont) para que el
// dibujo no se corte
const graph = GITGRAPH.map((c, r) => {
  const next = GITGRAPH[r + 1]?.graph ?? '';
  const chars = [...c.graph].map((ch, i) => ({
    ch,
    cont: '*|'.includes(ch) && [i - 1, i, i + 1].some((j) => (next[j] ?? ' ') !== ' '),
  }));
  return { ...c, chars };
});
---

<section id="sobre-mi" class="section about">
  <div class="container">
    <SectionHeading path="~/sobre-mi" cmd="cat sobre-mi.md" title={t.about.title} />

    <div class="about__grid">
      <div class="about__photo reveal">
        <div class="photo">
            <Image src={profile} alt={t.about.photoAlt} widths={[300, 460]} sizes="(max-width: 760px) 80vw, 340px" format="webp" />
        </div>
      </div>

      <div class="about__text prose reveal">
        <p class="about__p1">{t.about.p1}</p>
        <p>{t.about.p2}</p>
      </div>

      <div class="about__panel reveal">
        <p class="panel__cmd"><span class="c-accent">❯</span> pacman -Q <span class="c-muted"># {t.about.stackTitle}</span></p>
        <ul class="pkgs">
          {
            STACK.map((s) => (
              <li>
                <span class="pkgs__icon" aria-hidden="true">{s.icon}</span>
                <span class="pkgs__name">{s.pkg}</span>
                <span class="pkgs__ver">{s.use[lang]}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="about__panel about__log reveal">
        <p class="panel__cmd"><span class="c-accent">❯</span> git log --graph --oneline --decorate <span class="c-muted"># {t.about.logTitle}</span></p>
        <ol class="log">
          {
            graph.map((c) => (
              <li aria-hidden={c.msg ? undefined : 'true'}>
                <span class="log__graph" aria-hidden="true">
                  {c.chars.map((g, i) => (
                    <span class:list={[i === 0 ? 'g-main' : 'g-branch', { 'g-cont': g.cont }]}>{g.ch}</span>
                  ))}
                </span>
                <span>
                  {c.hash && <span class="log__hash">{c.hash}</span>}
                  {c.refs && <span class="log__tag"> ({c.refs})</span>}
                  {c.msg && ` ${c.msg[lang]}`}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    grid-template-areas:
      'photo text'
      'photo pkgs'
      'log log';
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .about__photo {
    grid-area: photo;
  }
  .about__text {
    grid-area: text;
    font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.1rem);
  }
  .about__text p {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  .about__text .about__p1 {
    color: var(--fg);
  }
  .about__panel:nth-of-type(3) {
    grid-area: pkgs;
  }
  .about__panel:nth-of-type(4) {
    grid-area: log;
  }
  .about__panel {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .panel__cmd {
    margin: 0 0 1rem;
  }

  .photo {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--accent);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: multiply;
    transition: filter 0.5s, mix-blend-mode 0.5s;
  }
  :global([data-theme='latte']) .photo :global(img) {
    mix-blend-mode: luminosity;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgb(0 0 0 / 0.18) 2px 3px);
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .about__photo:hover .photo :global(img) {
    filter: none;
    mix-blend-mode: normal;
  }
  .about__photo:hover .photo::after {
    opacity: 0;
  }

  .pkgs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 0.35rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pkgs li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .pkgs__icon {
    width: 1.2em;
    color: var(--accent);
  }
  .pkgs__ver {
    margin-left: auto;
    color: var(--accent-2);
  }

  .log {
    margin: 0;
    padding: 0;
    list-style: none;
    /* interlineado justo para que las líneas de las ramas se toquen */
    line-height: 1.35;
  }
  .log li {
    display: grid;
    /* el dibujo de cada fila ya trae su espacio final, como en git */
    grid-template-columns: auto minmax(0, 1fr);
  }
  .log__graph {
    overflow: hidden;
    white-space: pre;
  }
  .log__graph span {
    display: inline-block;
    position: relative;
    vertical-align: top;
  }
  .g-main {
    color: var(--accent);
  }
  .g-branch {
    color: var(--magenta);
  }
  /* prolongación de la rama si el mensaje ocupa más de una línea (la recorta la fila) */
  .g-cont::after {
    content: '|\A|\A|\A|\A|';
    position: absolute;
    top: 100%;
    left: 0;
  }
  .log__hash {
    color: var(--warn);
  }
  .log__tag {
    color: var(--info);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'photo' 'text' 'pkgs' 'log';
    }
    .about__photo {
      max-width: 320px;
    }
  }
</style>
