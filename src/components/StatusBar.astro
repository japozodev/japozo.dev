---
// Barra inferior estilo tmux: navegación principal + reloj
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const windows = [
  { id: 'inicio', label: t.nav.home },
  { id: 'proyectos', label: t.nav.projects },
  { id: 'sobre-mi', label: t.nav.about },
  { id: 'contacto', label: t.nav.contact },
];
---

<nav class="tmux" aria-label="Main">
  <span class="tmux__session" aria-hidden="true">[japozo]</span>
  <ul class="tmux__windows">
    {
      windows.map((w, i) => (
        <li>
          <a href={`#${w.id}`} data-section={w.id} aria-current={i === 0 ? 'true' : undefined}>
            <span class="tmux__n">{i + 1}:</span>
            <span class="tmux__label">{w.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <span class="tmux__right" aria-hidden="true">
    <span class="tmux__host">pozo@japozo</span>
    <span class="tmux__clock" id="tmux-clock">--:--</span>
  </span>
</nav>

<style>
  .tmux {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: flex;
    align-items: stretch;
    height: var(--statusbar-h);
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: content-box;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
  }
  .tmux__session {
    display: flex;
    align-items: center;
    padding-inline: 0.8rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .tmux__windows {
    display: flex;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tmux__windows li {
    display: flex;
  }
  .tmux__windows a {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding-inline: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, background-color 0.2s;
  }
  .tmux__windows a:hover {
    color: var(--fg);
  }
  .tmux__windows a[aria-current='true'] {
    background: var(--surface-2);
    color: var(--accent);
    font-weight: 700;
  }
  .tmux__windows a[aria-current='true'] .tmux__label::after {
    content: '*';
  }
  .tmux__right {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: 0.8rem;
    color: var(--muted);
  }
  .tmux__clock {
    color: var(--fg);
  }

  /* modo cubo: los workspaces salen de la barra y se apilan a la izquierda */
  :global(html.cube) .tmux__windows {
    position: fixed;
    top: calc(var(--header-h) + (100dvh - var(--header-h) - var(--statusbar-h)) / 2);
    left: 0;
    width: var(--nav-w);
    flex-direction: column;
    gap: 0.7rem;
    padding-inline: 1.5rem 1rem;
    transform: translateY(-50%);
  }
  :global(html.cube) .tmux__windows a {
    position: relative;
    gap: 0.6rem;
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.85rem;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s, transform 0.2s;
  }
  :global(html.cube) .tmux__windows a:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
    transform: translateX(3px);
  }
  :global(html.cube) .tmux__windows a[aria-current='true'] {
    border-color: transparent;
    border-image: linear-gradient(45deg, var(--accent), var(--accent-2)) 1;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    box-shadow: 0 0 24px -8px var(--glow);
  }
  :global(html.cube) .tmux__right {
    margin-left: auto;
  }
  :global(html.cube) .tmux__n {
    color: var(--muted);
  }
  :global(html.cube) .tmux__windows a[aria-current='true'] .tmux__n {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .tmux__host {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .tmux__session,
    .tmux__right {
      display: none;
    }
    .tmux__windows li {
      flex: 1;
    }
    .tmux__windows a {
      flex: 1;
      justify-content: center;
      padding-inline: 0.3rem;
    }
  }
  @media (max-width: 380px) {
    .tmux__n {
      display: none;
    }
  }
</style>

<script>
  import { initWorkspaces, onWorkspaceChange } from '../scripts/workspaces';

  // Reloj
  const clock = document.getElementById('tmux-clock');
  const tick = () => {
    if (clock) clock.textContent = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
  };
  tick();
  setInterval(tick, 15_000);

  // Workspace activo; la navegación y las teclas 1-4 viven en workspaces.ts
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tmux [data-section]')];
  onWorkspaceChange((id) =>
    links.forEach((l) => (l.dataset.section === id ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current'))),
  );
  initWorkspaces();
</script>
