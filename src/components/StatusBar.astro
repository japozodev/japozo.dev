---
// Barra inferior estilo tmux: navegación principal + reloj
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const windows = [
  { id: 'inicio', label: t.nav.home },
  { id: 'proyectos', label: t.nav.projects },
  { id: 'sobre-mi', label: t.nav.about },
  { id: 'contacto', label: t.nav.contact },
];
---

<nav class="tmux" aria-label="Main">
  <span class="tmux__session" aria-hidden="true">[japozo]</span>
  <ul class="tmux__windows">
    {
      windows.map((w, i) => (
        <li>
          <a href={`#${w.id}`} data-section={w.id} aria-current={i === 0 ? 'true' : undefined}>
            <span class="tmux__n">{i}:</span>
            <span class="tmux__label">{w.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <span class="tmux__right" aria-hidden="true">
    <span class="tmux__host">pozo@manjaro</span>
    <span class="tmux__clock" id="tmux-clock">--:--</span>
  </span>
</nav>

<style>
  .tmux {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: flex;
    align-items: stretch;
    height: var(--statusbar-h);
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: content-box;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
  }
  .tmux__session {
    display: flex;
    align-items: center;
    padding-inline: 0.8rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .tmux__windows {
    display: flex;
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tmux__windows li {
    display: flex;
  }
  .tmux__windows a {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding-inline: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, background-color 0.2s;
  }
  .tmux__windows a:hover {
    color: var(--fg);
  }
  .tmux__windows a[aria-current='true'] {
    background: var(--surface-2);
    color: var(--accent);
    font-weight: 700;
  }
  .tmux__windows a[aria-current='true'] .tmux__label::after {
    content: '*';
  }
  .tmux__right {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: 0.8rem;
    color: var(--muted);
  }
  .tmux__clock {
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .tmux__host {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .tmux__session,
    .tmux__right {
      display: none;
    }
    .tmux__windows li {
      flex: 1;
    }
    .tmux__windows a {
      flex: 1;
      justify-content: center;
      padding-inline: 0.3rem;
    }
  }
  @media (max-width: 380px) {
    .tmux__n {
      display: none;
    }
  }
</style>

<script>
  // Reloj
  const clock = document.getElementById('tmux-clock');
  const tick = () => {
    if (clock) clock.textContent = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
  };
  tick();
  setInterval(tick, 15_000);

  // Ventana activa según la sección visible
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tmux [data-section]')];
  const setActive = (id: string) =>
    links.forEach((l) => (l.dataset.section === id ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));

  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((l) => {
    const s = document.getElementById(l.dataset.section!);
    if (s) observer.observe(s);
  });

  // Atajos: teclas 0-3 como en tmux (fuera de inputs)
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.ctrlKey || e.metaKey || e.altKey || target.matches('input, textarea')) return;
    const link = links[Number(e.key)];
    if (link) document.getElementById(link.dataset.section!)?.scrollIntoView();
  });
</script>
