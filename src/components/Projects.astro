---
import type { Lang } from '../data/site';
import { PROJECTS } from '../data/site';
import { useTranslations } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="proyectos" class="section">
  <div class="container">
    <SectionHeading index="01" path="~/proyectos" cmd="ls -la" title={t.projects.title} lead={t.projects.lead} />
    <div class="projects">
      {PROJECTS.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
    <!-- aviso de que la lista sigue; solo se ve en el cubo -->
    <p class="projects__more" aria-hidden="true"><b>↓</b> {t.projects.more.replace('{n}', String(PROJECTS.length))}</p>
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }
  @media (max-width: 760px) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
