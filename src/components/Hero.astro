---
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';
import Terminal from './Terminal.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="inicio" class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker"><span class="dot"></span>{t.hero.kicker}</p>
      <h1 class="hero__title">
        <span class="hero__hello">{t.hero.hello}</span>
        <span class="hero__name" data-text="Pozo">Pozo</span><span class="hero__cursor" aria-hidden="true"></span>
      </h1>
      <p class="hero__role">
        <span class="c-accent" aria-hidden="true">❯ </span>
        <span class="sr-only">{t.hero.roles[0]}</span>
        <span id="role-rotator" aria-hidden="true" data-roles={JSON.stringify(t.hero.roles)}>{t.hero.roles[0]}</span>
      </p>
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__cta">
        <a href="#proyectos" class="btn btn--primary"><span aria-hidden="true">{''}</span>{t.hero.ctaProjects}</a>
        <a href="#contacto" class="btn btn--ghost"><span aria-hidden="true">{''}</span>{t.hero.ctaContact}</a>
      </div>
    </div>

    <Terminal lang={lang} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100dvh - 3.75rem - var(--statusbar-h));
    padding-block: clamp(2.5rem, 6vw, 4rem);
    isolation: isolate;
  }
  /* rejilla + resplandor */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 75% 40%, var(--glow), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--border) 45%, transparent) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, color-mix(in srgb, var(--border) 45%, transparent) 1px, transparent 1px) 0 0 / 40px 40px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, #000 40%, transparent 100%);
    opacity: 0.9;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--glow);
    animation: pulse 2s infinite;
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .hero__hello {
    display: block;
    font-size: 0.42em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    margin-bottom: 0.2em;
  }
  .hero__name {
    position: relative;
    display: inline-block;
    color: var(--accent);
    text-shadow: 0 0 30px var(--glow);
  }
  /* glitch al pasar el ratón */
  .hero__name::before,
  .hero__name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .hero__name:hover::before {
    opacity: 0.8;
    color: var(--info);
    animation: glitch 0.35s steps(2) infinite;
  }
  .hero__name:hover::after {
    opacity: 0.8;
    color: var(--danger);
    animation: glitch 0.35s steps(2) infinite reverse;
  }
  .hero__cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.85em;
    margin-left: 0.08em;
    background: var(--accent);
    vertical-align: -0.05em;
    animation: blink 1.1s steps(1) infinite;
  }
  .hero__role {
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    min-height: 1.6em;
  }
  #role-rotator::after {
    content: '▏';
    color: var(--accent);
    animation: blink 0.9s steps(1) infinite;
  }
  .hero__lead {
    max-width: 52ch;
    margin: 1.25rem 0 2rem;
    color: var(--muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @keyframes glitch {
    0% {
      transform: translate(2px, -1px);
      clip-path: inset(10% 0 55% 0);
    }
    50% {
      transform: translate(-2px, 1px);
      clip-path: inset(60% 0 5% 0);
    }
    100% {
      transform: translate(1px, 2px);
      clip-path: inset(30% 0 35% 0);
    }
  }
</style>

<script>
  // Rotador de roles con efecto de escritura
  const el = document.getElementById('role-rotator');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const roles: string[] = JSON.parse(el.dataset.roles || '[]');
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      let i = 0;
      while (roles.length > 1) {
        await sleep(2600);
        for (let n = roles[i].length; n >= 0; n--) {
          el.textContent = roles[i].slice(0, n);
          await sleep(25);
        }
        i = (i + 1) % roles.length;
        for (let n = 1; n <= roles[i].length; n++) {
          el.textContent = roles[i].slice(0, n);
          await sleep(55);
        }
      }
    })();
  }
</script>
