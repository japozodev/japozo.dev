---
// El hero es una sesión de terminal: fastfetch, cat bio.txt, ls y un prompt vivo.
// Todo se renderiza en el servidor; el JS solo añade el arranque y los comandos.
import type { Lang } from '../data/site';
import { SITE } from '../data/site';
import { LOGO, LOGO_COLS } from '../data/logo';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const now = new Date();
const age = now.getFullYear() - SITE.birth.year - (now.getMonth() + 1 < SITE.birth.month ? 1 : 0);
const dirs = [
  { id: 'proyectos', label: lang === 'es' ? 'proyectos' : 'projects' },
  { id: 'sobre-mi', label: lang === 'es' ? 'sobre-mi' : 'about' },
  { id: 'contacto', label: lang === 'es' ? 'contacto' : 'contact' },
];
---

<section id="inicio" class="hero">
  <div class="container">
    <div class="session" id="session" style={`--logo-cols:${LOGO_COLS}`}>
      <div class="step">
        <p class="cmd" aria-hidden="true">
          <span class="ps1"><b>pozo@japozo</b> <i>~</i> $</span> <span class="typed">fastfetch</span>
        </p>
        <div class="ff" id="ff">
          <h1 class="ff__logo">
            <span class="sr-only">{t.hero.a11yTitle}</span>
            <span class="ff__art" aria-hidden="true">{LOGO}</span>
          </h1>
          <div class="ff__info">
            <p class="ff__title"><b>pozo</b>@<b>japozo.dev</b></p>
            <p class="ff__rule" aria-hidden="true">{'-'.repeat(15)}</p>
            <dl>
              {
                t.hero.ff.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
              <div>
                <dt>{t.hero.uptime}</dt>
                <dd><span data-age>{age}</span> {t.hero.years}</dd>
              </div>
            </dl>
            <p class="ff__colors" aria-hidden="true">
              {['fg', 'danger', 'accent', 'warn', 'info', 'magenta', 'accent-2', 'muted'].map((c) => <span style={`--c:var(--${c})`} />)}
            </p>
          </div>
        </div>
      </div>

      <div class="step">
        <p class="cmd" aria-hidden="true">
          <span class="ps1"><b>pozo@japozo</b> <i>~</i> $</span> <span class="typed">cat bio.txt</span>
        </p>
        <p class="bio">{t.hero.bio}</p>
        <p class="bio-sub">{t.hero.bioSub}</p>
      </div>

      <div class="step">
        <p class="cmd" aria-hidden="true">
          <span class="ps1"><b>pozo@japozo</b> <i>~</i> $</span> <span class="typed">ls</span>
        </p>
        <nav class="ls" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
          {dirs.map((d) => <a href={`#${d.id}`}>{d.label}/</a>)}
        </nav>
      </div>

      <div class="log" id="term-log" role="log" aria-live="polite"></div>

      <form class="step cmd prompt" id="term-form" autocomplete="off">
        <label for="term-input" class="ps1"><b>pozo@japozo</b> <i>~</i> $<span class="sr-only"> {t.hero.inputLabel}</span></label>
        <input
          id="term-input"
          type="text"
          placeholder={t.hero.placeholder}
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          enterkeyhint="send"
        />
      </form>

      <div class="boot" id="boot" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.5rem, 7vh, 5.5rem) clamp(2.5rem, 7vh, 5rem);
    border-bottom: 1px solid var(--border);
  }
  .session {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vh, 2.25rem);
    font-size: clamp(0.82rem, 0.78rem + 0.2vw, 0.95rem);
  }
  .session p {
    margin: 0;
  }

  /* prompt */
  .cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1ch;
    margin: 0 0 0.9rem;
  }
  .session :global(.ps1) {
    white-space: nowrap;
    color: var(--fg);
  }
  .session :global(.ps1 b) {
    color: var(--accent);
  }
  .session :global(.ps1 i) {
    font-style: normal;
    color: var(--info);
    font-weight: 700;
  }

  /* fastfetch */
  .ff {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-top: 0.35rem;
  }
  .ff__logo {
    margin: 0;
    font-size: 1em;
    font-weight: 400;
  }
  .ff__art {
    display: block;
    white-space: pre;
    line-height: 1.2;
    color: var(--accent);
    /* tapa las juntas de antialiasing entre bloques */
    text-shadow:
      0.03em 0 currentColor,
      0 0.03em currentColor;
    /* el ancho del logo marca el tamaño: 47 columnas ≈ 600px en escritorio */
    font-size: clamp(0.5rem, min(1.85vw, 3vh), 1.4rem);
  }
  .ff__info {
    line-height: 1.6;
  }
  .ff__title b {
    color: var(--accent);
  }
  .ff__rule {
    color: var(--muted);
  }
  .ff__info dl {
    margin: 0;
  }
  .ff__info dl div {
    display: flex;
    gap: 1ch;
  }
  .ff__info dt {
    color: var(--accent);
    font-weight: 700;
  }
  .ff__info dt::after {
    content: ':';
  }
  .ff__info dd {
    margin: 0;
  }
  .ff__colors {
    display: flex;
    margin-top: 0.8rem !important;
  }
  .ff__colors span {
    width: 3ch;
    height: 1.2em;
    background: var(--c);
  }

  /* cat bio.txt */
  .bio {
    max-width: 24ch;
    font-size: clamp(1.6rem, min(1rem + 2.6vw, 5.5vh), 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .bio-sub {
    max-width: 58ch;
    margin-top: 1rem !important;
    color: var(--muted);
  }

  /* ls */
  .ls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 3ch;
  }
  .ls a {
    color: var(--info);
    font-weight: 700;
    text-decoration: none;
  }
  .ls a:hover {
    background: var(--info);
    color: var(--bg);
  }

  /* prompt vivo */
  .prompt {
    margin: 0;
  }
  .prompt input {
    flex: 1;
    min-width: 12ch;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--accent);
    outline: none;
  }
  .prompt input::placeholder {
    color: var(--muted);
    opacity: 0.6;
  }
  .prompt:focus-within .ps1 {
    text-decoration: none;
  }

  /* salida de comandos (generada en terminal.ts) */
  .log:empty {
    display: none;
  }
  .log {
    display: grid;
    gap: 0.25rem;
  }
  .log :global(.line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.line.is-cmd:not(:first-child)) {
    margin-top: 1rem;
  }
  .log :global(.ok) {
    color: var(--accent);
  }
  .log :global(a) {
    color: var(--info);
    font-weight: 700;
    text-decoration: none;
  }
  .log :global(a:hover) {
    background: var(--info);
    color: var(--bg);
  }
  .log :global(.cols) {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 3ch;
  }
  .log :global(.ff) {
    margin-block: 0.5rem 1rem;
  }

  /* arranque */
  .boot {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    font-size: 0.85em;
    color: var(--muted);
  }
  .boot :global(div) {
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .boot :global(.ok) {
    color: var(--accent);
  }
  .session.is-booting .boot {
    display: flex;
  }
  .session.is-booting .step,
  .session .step.is-pending {
    visibility: hidden;
  }

  @media (max-width: 900px) {
    .ff {
      grid-template-columns: minmax(0, 1fr);
    }
    /* el logo ocupa el ancho disponible en móvil */
    .ff__art {
      font-size: min(calc((100vw - 2 * var(--gutter)) / var(--logo-cols) / 0.602), 1.4rem);
    }
  }
</style>

<script>
  import { initTerminal } from '../scripts/terminal';
  initTerminal();
</script>
