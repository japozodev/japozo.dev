---
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';
import Desktop from './Desktop.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="inicio" class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker"><span class="dot"></span>{t.hero.kicker}</p>
      <h1 class="hero__title">
        <span class="hero__hello">{t.hero.hello}</span>
        <span class="hero__name" data-text="Pozo">Pozo</span><span class="hero__cursor" aria-hidden="true"></span>
      </h1>
      <p class="hero__role">
        <span class="c-accent" aria-hidden="true">❯ </span>
        <span class="sr-only">{t.hero.roles[0]}</span>
        <span id="role-rotator" aria-hidden="true" data-roles={JSON.stringify(t.hero.roles)}>{t.hero.roles[0]}</span>
      </p>
      <p class="hero__lead prose">{t.hero.lead}</p>
      <div class="hero__cta">
        <a href="#proyectos" class="btn btn--primary"><span aria-hidden="true">{''}</span>{t.hero.ctaProjects}</a>
        <a href="#contacto" class="btn btn--ghost"><span aria-hidden="true">{''}</span>{t.hero.ctaContact}</a>
      </div>
      <!-- pista para deslizar; solo se ve en móvil y tablet -->
      <p class="hero__swipe" aria-hidden="true"><span>{t.hero.swipe}</span><b>→</b></p>
      <!-- atajos del cubo; solo se ven en modo cubo -->
      <ul class="hero__keys" aria-hidden="true">
        <li><kbd>←</kbd><kbd>→</kbd>{t.hero.keys[0]}</li>
        <li><kbd>1</kbd>-<kbd>4</kbd>{t.hero.keys[1]}</li>
        <li><kbd>↑</kbd><kbd>↓</kbd>{t.hero.keys[2]}</li>
        <li><kbd>{t.hero.keys[3]}</kbd>{t.hero.keys[4]}</li>
      </ul>
    </div>

    <Desktop lang={lang} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100dvh - 3.75rem - var(--statusbar-h));
    padding-block: clamp(2.5rem, 6vw, 4rem);
    isolation: isolate;
  }
  /* wallpaper: pistas de placa de circuito (ver src/pages/wallpaper.svg.ts) */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    -webkit-mask: url('/wallpaper.svg') center / cover no-repeat;
    mask: url('/wallpaper.svg') center / cover no-repeat;
    opacity: 0.26;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--glow);
    animation: pulse 2s infinite;
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .hero__hello {
    display: block;
    font-size: 0.42em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    margin-bottom: 0.2em;
  }
  .hero__name {
    position: relative;
    display: inline-block;
    color: var(--accent);
    text-shadow: 0 0 30px var(--glow);
  }
  /* glitch cyberpunk: tiras del propio nombre que se desplazan, sin colores extra.
     Salta solo cada pocos segundos y se queda fijo al pasar el ratón */
  .hero__name {
    animation: jolt 7s steps(1) infinite;
  }
  .hero__name::before,
  .hero__name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    text-shadow: none;
    pointer-events: none;
  }
  .hero__name::before {
    animation: tear-a 7s steps(1) infinite;
  }
  .hero__name::after {
    color: var(--fg);
    animation: tear-b 7s steps(1) infinite;
  }
  .hero__name:hover {
    animation-duration: 0.9s;
  }
  .hero__name:hover::before,
  .hero__name:hover::after {
    animation-duration: 0.9s;
  }
  .hero__cursor {
    display: inline-block;
    /* bloque macizo, pero estrecho y algo translúcido para que no pese más que el nombre */
    width: 0.135em;
    height: 0.82em;
    margin-left: 0.1em;
    background: color-mix(in srgb, var(--accent) 70%, transparent);
    vertical-align: -0.02em;
    animation: blink 1.1s steps(1) infinite;
  }
  .hero__role {
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    min-height: 1.6em;
  }
  #role-rotator::after {
    content: '▏';
    color: var(--accent);
    animation: blink 0.9s steps(1) infinite;
  }
  .hero__lead {
    max-width: 52ch;
    margin: 1.25rem 0 2rem;
    color: var(--muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero__keys {
    display: none;
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
    }
    .hero__bg {
      opacity: 0.16;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  /* el glitch ocupa solo el tramo final del ciclo; con hover el ciclo dura menos */
  @keyframes jolt {
    0%, 86%, 100% { transform: none; }
    88% { transform: translateX(0.03em) skewX(-6deg); }
    91% { transform: translateX(-0.02em); }
    94% { transform: skewX(4deg); }
    97% { transform: translateX(0.015em); }
  }
  @keyframes tear-a {
    0%, 86%, 100% { opacity: 0; }
    87% { opacity: 1; clip-path: inset(14% 0 66% 0); transform: translateX(-0.09em); }
    90% { opacity: 1; clip-path: inset(62% 0 20% 0); transform: translateX(0.07em); }
    93% { opacity: 1; clip-path: inset(38% 0 48% 0); transform: translateX(-0.05em); }
    96% { opacity: 1; clip-path: inset(80% 0 6% 0); transform: translateX(0.11em); }
    98% { opacity: 1; clip-path: inset(4% 0 86% 0); transform: translateX(-0.04em); }
  }
  @keyframes tear-b {
    0%, 86%, 100% { opacity: 0; }
    88% { opacity: 0.9; clip-path: inset(46% 0 50% 0); transform: translateX(0.12em); }
    92% { opacity: 0.9; clip-path: inset(22% 0 75% 0); transform: translateX(-0.1em); }
    95% { opacity: 0.9; clip-path: inset(70% 0 27% 0); transform: translateX(0.06em); }
    98% { opacity: 0; }
  }
</style>

<script>
  // Rotador de roles con efecto de escritura
  const el = document.getElementById('role-rotator');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const roles: string[] = JSON.parse(el.dataset.roles || '[]');
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      let i = 0;
      while (roles.length > 1) {
        await sleep(2600);
        for (let n = roles[i].length; n >= 0; n--) {
          el.textContent = roles[i].slice(0, n);
          await sleep(25);
        }
        i = (i + 1) % roles.length;
        for (let n = 1; n <= roles[i].length; n++) {
          el.textContent = roles[i].slice(0, n);
          await sleep(55);
        }
      }
    })();
  }
</script>
