---
// Ventana estilo Hyprland: sin botones, borde gris si está inactiva y borde
// en degradado (accent -> accent-2) cuando está activa (hover o foco dentro).
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['window', className]}>
  {
    title && (
      <div class="window__bar" aria-hidden="true">
        <span class="window__title">{title}</span>
      </div>
    )
  }
  <div class="window__body">
    <slot />
  </div>
</div>

<style>
  .window {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-alt);
    border: var(--win-border) solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.3s;
  }
  /* borde activo en degradado, dibujado con máscara para no tapar fondos translúcidos */
  .window::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--win-border));
    z-index: 2;
    padding: var(--win-border);
    border-radius: inherit;
    background: linear-gradient(45deg, var(--accent), var(--accent-2));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .window:hover::before,
  .window:focus-within::before,
  .window.is-active::before {
    opacity: 1;
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--muted);
    user-select: none;
  }
  .window__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .window__body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 0 0 calc(var(--radius) - var(--win-border)) calc(var(--radius) - var(--win-border));
  }
  .window__bar + .window__body {
    border-radius: 0 0 calc(var(--radius) - var(--win-border)) calc(var(--radius) - var(--win-border));
  }
  .window__body:only-child {
    border-radius: calc(var(--radius) - var(--win-border));
  }
</style>
