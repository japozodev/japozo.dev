---
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';
import Window from './Window.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const chips = lang === 'es' ? ['help', 'whoami', 'proyectos', 'tema', 'sudo hire-me'] : ['help', 'whoami', 'projects', 'theme', 'sudo hire-me'];
---

<div class="terminal-wrap">
  <Window title={t.terminal.title} class="terminal">
    <div class="term" id="term" data-booting>
      <div class="term__out" id="term-out" role="log" aria-live="polite"></div>
      <form class="term__line" id="term-form" autocomplete="off">
        <span class="prompt" aria-hidden="true">
          <span class="seg seg--os">{''}</span><span class="seg seg--path">~</span><span class="seg-end">{''}</span>
        </span>
        <label for="term-input" class="sr-only">{t.terminal.inputLabel}</label>
        <input
          id="term-input"
          class="term__input"
          type="text"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          enterkeyhint="send"
        />
      </form>
      <span class="term__skip" aria-hidden="true">{t.terminal.skip}</span>
    </div>
  </Window>

  <div class="chips" aria-label={t.terminal.hint}>
    <span class="chips__label">{t.terminal.hint}</span>
    {chips.map((c) => <button type="button" class="chip" data-cmd={c}>{c}</button>)}
  </div>
</div>

<style>
  .terminal-wrap {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .terminal {
    position: relative;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent),
      0 40px 80px -30px var(--glow),
      0 30px 60px -30px rgb(0 0 0 / 0.7);
  }
  .term {
    position: relative;
    height: clamp(21rem, 52vh, 30rem);
    overflow-y: auto;
    padding: 1rem 1.1rem 1.2rem;
    font-size: clamp(0.72rem, 0.68rem + 0.25vw, 0.85rem);
    line-height: 1.55;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  /* scanlines muy sutiles */
  .term::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      color-mix(in srgb, var(--bg) 25%, transparent) 2px 3px
    );
    opacity: 0.35;
  }
  .term__out :global(.line) {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term__out :global(.line.boot) {
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term__line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }
  [data-booting] .term__line {
    visibility: hidden;
  }
  .prompt,
  .term :global(.prompt) {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 1.5;
  }
  .term :global(.seg) {
    padding-inline: 0.5em;
  }
  .term :global(.seg--os) {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .term :global(.seg--path) {
    background: var(--surface-2);
    color: var(--fg);
  }
  .term :global(.seg-end) {
    color: var(--surface-2);
  }
  .term__input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--accent);
    outline: none;
  }
  .term__skip {
    position: absolute;
    right: 1rem;
    bottom: 0.6rem;
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.3s;
  }
  [data-booting] .term__skip {
    opacity: 0.8;
  }

  /* salida generada desde terminal.ts */
  .term :global(.ok) {
    color: var(--accent);
  }
  .term :global(.ts) {
    color: var(--muted);
  }
  .term :global(.cursor) {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  .term :global(.neofetch) {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-block: 0.4rem 0.6rem;
  }
  .term :global(.neofetch__logo) {
    margin: 0;
    font: inherit;
    line-height: 1.05;
    color: var(--accent);
    flex-shrink: 0;
  }
  .term :global(.neofetch__info) {
    min-width: 0;
  }
  .term :global(.neofetch__key) {
    color: var(--accent);
    font-weight: 700;
  }
  .term :global(.palette) {
    display: flex;
    margin-top: 0.4rem;
  }
  .term :global(.palette span) {
    width: 1.6em;
    height: 1em;
  }
  .term :global(a) {
    color: var(--info);
  }
  .term :global(.cols) {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 2ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
  }
  .chips__label {
    color: var(--muted);
  }
  .chip {
    padding: 0.3rem 0.7rem;
    border: 1px dashed var(--border);
    border-radius: 999px;
    background: none;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  }
  .chip::before {
    content: '$ ';
    color: var(--accent);
  }
  .chip:hover {
    border-style: solid;
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  @media (max-width: 560px) {
    .term :global(.neofetch) {
      flex-direction: column;
      gap: 0.6rem;
    }
    .term :global(.neofetch__logo) {
      font-size: 0.55em;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { initTerminal } from '../scripts/terminal';
  initTerminal();
</script>
