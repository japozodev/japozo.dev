---
// Ventana de terminal (kitty). La principal arranca con boot; las demás se clonan desde
// <template id="kitty-tpl"> cuando alguien escribe `kitty`.
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';
import Window from './Window.astro';

interface Props {
  lang: Lang;
  kitty?: boolean;
}

const { lang, kitty = false } = Astro.props;
const t = useTranslations(lang);
---

<Window title={kitty ? 'kitty: ~' : t.terminal.title} class:list={['tile', 'terminal', kitty ? 'tile--kitty' : 'tile--main']}>
  <div class="term">
    <div class="term__out" role="log" aria-live="polite"></div>
    <form class="term__line" autocomplete="off">
      <label class="prompt">
        <span aria-hidden="true"><span class="seg seg--os">pozo</span><span class="seg seg--path">~</span><span class="seg-end">{'\ue0b0'}</span></span>
        <span class="sr-only">{t.terminal.inputLabel}</span>
        <input class="term__input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" enterkeyhint="send" />
      </label>
    </form>
    {!kitty && <span class="term__skip" aria-hidden="true">{t.terminal.skip}</span>}
  </div>
</Window>

<style>
  /* ventana inactiva translúcida con blur, como en Hyprland: opaca al pasar el ratón o al escribir */
  /* .tile.terminal para ganar en especificidad a .window */
  .tile.terminal {
    position: relative;
    background: color-mix(in srgb, var(--bg-alt) var(--inactive-alpha), transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.6);
    transition: background-color 0.35s ease;
  }
  .tile.terminal :global(.window__bar) {
    background: color-mix(in srgb, var(--surface) var(--inactive-alpha), transparent);
    transition: background-color 0.35s ease;
  }
  .tile.terminal:hover,
  .tile.terminal:focus-within {
    background: var(--bg-alt);
  }
  .tile.terminal:hover :global(.window__bar),
  .tile.terminal:focus-within :global(.window__bar) {
    background: var(--surface);
  }
  .term {
    position: relative;
    container-type: inline-size;
    height: clamp(17rem, 47vh, 27.5rem);
    overflow-y: auto;
    padding: 1rem 1.1rem 1.2rem;
    font-size: clamp(0.72rem, 0.68rem + 0.2vw, 0.82rem);
    line-height: 1.45;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  /* scanlines muy sutiles */
  .term::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      color-mix(in srgb, var(--bg) 25%, transparent) 2px 3px
    );
    opacity: 0.35;
  }
  .term__out :global(.line) {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term__out :global(.line.boot) {
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term__line {
    margin-top: 0.25rem;
  }
  .term .term__line .prompt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  [data-booting] .term__line {
    visibility: hidden;
  }
  .term :global(.prompt) {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 1.5;
  }
  .term :global(.seg) {
    padding-inline: 0.5em;
  }
  .term :global(.seg--os) {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .term :global(.seg--path) {
    background: var(--surface-2);
    color: var(--fg);
  }
  .term :global(.seg-end) {
    color: var(--surface-2);
  }
  /* kitty: ocupa el alto de su celda del mosaico */
  .tile--kitty .term {
    height: 100%;
    min-height: 12rem;
  }
  :global(.term-fx) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .term__input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--accent);
    outline: none;
  }
  .term__skip {
    position: absolute;
    right: 1rem;
    bottom: 0.6rem;
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.3s;
  }
  [data-booting] .term__skip {
    opacity: 0.8;
  }

  /* salida generada desde terminal.ts */
  .term :global(.ok) {
    color: var(--accent);
  }
  .term :global(.ts) {
    color: var(--muted);
  }
  .term :global(.cursor) {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  .term :global(.ff) {
    display: grid;
    gap: 0.6rem;
    margin-block: 0.3rem 0.6rem;
  }
  .term :global(.ff__logo) {
    margin: 0;
    font: inherit;
    /* 47 columnas de logo: se ajusta al ancho de la terminal */
    font-size: min(1em, calc((100cqi - 0.5rem) / 47 / 0.602));
    line-height: 1.2;
    color: var(--accent);
    /* tapa las juntas de antialiasing entre bloques */
    text-shadow:
      0.03em 0 currentColor,
      0 0.03em currentColor;
  }
  .term :global(.ff__key) {
    color: var(--accent);
    font-weight: 700;
  }
  .term :global(.palette) {
    display: flex;
    margin-top: 0.4rem;
  }
  .term :global(.palette span) {
    width: 1.6em;
    height: 1em;
  }
  .term :global(a) {
    color: var(--info);
  }
  .term :global(.cols) {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 2ch;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
