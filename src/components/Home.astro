---
import { LOGO } from '../data/logo';
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import StatusBar from './StatusBar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="main">
    <div class="stage">
      <div class="cube-tilt" id="cube-tilt">
        <!-- cada cara va en un .face: en el cubo no pinta caja (display: contents) y en
             móvil es el hueco fijo que se desliza mientras la sección gira dentro -->
        <div class="cube" id="cube">
          <div class="face"><Hero lang={lang} /></div>
          <div class="face"><Projects lang={lang} /></div>
          <div class="face"><About lang={lang} /></div>
          <div class="face"><Contact lang={lang} /></div>
          <!-- tapas del cubo: decorativas, solo existen en modo cubo -->
          <div class="face face--lid">
            <div class="lid lid--top" aria-hidden="true">
              <div class="lid__in">
                <pre class="lid__logo">{LOGO}</pre>
                <p>japozo.dev <span class="c-accent">v27</span></p>
              </div>
            </div>
          </div>
          <div class="face face--lid">
            <div class="lid lid--bottom" aria-hidden="true">
              <div class="lid__in">
                <p class="lid__exit">exit 0</p>
                <p>© {year} J. A. Pozo</p>
                <p class="c-muted">{t.footer.made}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- en modo cubo la terminal y btop se sacan aquí, como ventanas del escritorio -->
    <aside class="dock" id="dock" aria-label="Terminal"></aside>
  </main>
  <script is:inline>
    if (document.documentElement.classList.contains('cube')) document.getElementById('dock').append(document.querySelector('.desktop'));
  </script>
  <footer class="footer">
    <div class="container footer__inner">
      <span>© {year} J. A. Pozo</span>
      <span class="c-muted">{t.footer.made}</span>
      <span class="c-accent" aria-hidden="true">exit 0</span>
    </div>
  </footer>
  <StatusBar lang={lang} />
</Base>

<style>
  .footer {
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
</style>

<script>
  // Aparición progresiva al hacer scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -10% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
