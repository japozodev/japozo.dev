---
// Cabecera de sección: línea de comando decorativa + título real
interface Props {
  cmd: string;
  path: string;
  title: string;
  lead?: string;
  index: string;
}

const { cmd, path, title, lead, index } = Astro.props;
---

<header class="sh reveal">
  <p class="sh__cmd" aria-hidden="true">
    <span class="ps1"><b>pozo@japozo</b> <i>{path}</i> $</span>
    <span class="sh__typed" style={`--n:${cmd.length}`}>{cmd}</span>
  </p>
  <h2 class="sh__title"><span class="sh__index" aria-hidden="true">{index}.</span>{title}</h2>
  {lead && <p class="sh__lead">{lead}</p>}
</header>

<style>
  .sh {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .sh__cmd {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    margin: 0 0 1rem;
    font-size: 0.85rem;
  }
  .ps1 b {
    color: var(--accent);
  }
  .ps1 i {
    font-style: normal;
    font-weight: 700;
    color: var(--info);
  }
  .sh__typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    border-right: 0.55em solid var(--accent);
  }
  :global(.is-visible) .sh__typed {
    animation:
      type 0.9s steps(var(--n)) 0.2s forwards,
      caret 1s steps(1) 1.1s infinite;
  }
  :global(html:not(.js)) .sh__typed {
    width: auto;
  }
  .sh__title {
    font-size: clamp(2rem, 1.2rem + 3.5vw, 3.6rem);
    letter-spacing: -0.03em;
  }
  .sh__index {
    color: var(--accent);
    font-size: 0.45em;
    vertical-align: super;
    margin-right: 0.5em;
  }
  .sh__lead {
    max-width: 60ch;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  @keyframes type {
    to {
      width: calc(var(--n) * 1ch + 0.55em);
    }
  }
  @keyframes caret {
    50% {
      border-color: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh__typed {
      width: auto;
    }
  }
</style>
