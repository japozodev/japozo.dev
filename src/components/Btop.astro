---
// Ventana estilo btop: las habilidades como gráficas de CPU y unos procesos de broma
import type { Lang } from '../data/site';
import Window from './Window.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

// porcentajes de la web anterior
const skills = [
  { name: 'HTML / CSS', v: 95 },
  { name: 'JavaScript', v: 85 },
  { name: 'UI / UX', v: 80 },
  { name: es ? 'Resolver problemas' : 'Problem solving', v: 85 },
  { name: es ? 'Trabajo en equipo' : 'Teamwork', v: 75 },
];

const procs = [
  { pid: 1, cmd: 'hyprland', cpu: 2.1 },
  { pid: 1337, cmd: 'astro dev', cpu: 7.4 },
  { pid: 2077, cmd: es ? 'cafe.service' : 'coffee.service', cpu: 12.8 },
];

const BLOCKS = '▁▂▃▄▅▆▇█';
const spark = (v: number) =>
  Array.from({ length: 24 }, (_, i) => BLOCKS[Math.min(7, Math.max(0, Math.round(((v - 12 + ((i * 37) % 17)) / 100) * 7)))]).join('');
---

<Window title="btop" class="tile tile--btop">
  <div class="btop" data-btop>
    <div class="btop__head">
      <span><b>cpu</b> <span class="c-muted">{es ? 'habilidades' : 'skills'}</span></span>
      <span class="c-muted" data-btop-clock>--:--:--</span>
    </div>
    <ul class="btop__rows">
      {
        skills.map((s) => (
          <li class="row" data-base={s.v}>
            <span class="row__name">{s.name}</span>
            <span class="row__spark" data-spark aria-hidden="true">{spark(s.v)}</span>
            <span class="row__pct" data-pct>{s.v}%</span>
          </li>
        ))
      }
    </ul>
    <div class="btop__head btop__head--proc">
      <span><b>proc</b></span>
      <span class="c-muted">cpu%</span>
    </div>
    <ul class="btop__procs">
      {
        procs.map((p) => (
          <li data-cpu={p.cpu}>
            <span class="c-muted">{String(p.pid).padStart(5)}</span>
            <span>{p.cmd}</span>
            <span class="proc__cpu" data-proc-cpu>{p.cpu.toFixed(1)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Window>

<style>
  .btop {
    padding: 0.6rem 1rem 0.7rem;
    font-size: clamp(0.68rem, 0.64rem + 0.18vw, 0.76rem);
    line-height: 1.45;
  }
  .btop__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.3rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px dashed var(--border);
  }
  .btop__head b {
    color: var(--accent);
  }
  .btop__head--proc {
    margin-top: 0.45rem;
  }
  .btop__rows,
  .btop__procs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 17ch) minmax(0, 1fr) 4.5ch;
    gap: 1ch;
    align-items: center;
  }
  .row__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row__spark {
    overflow: hidden;
    white-space: pre;
    text-align: right;
    line-height: 1.2;
    background: linear-gradient(90deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .row__pct {
    text-align: right;
    color: var(--fg);
  }
  .btop__procs li {
    display: grid;
    grid-template-columns: 5ch 1fr 5ch;
    gap: 1.5ch;
  }
  .proc__cpu {
    text-align: right;
    color: var(--warn);
  }
</style>

<script>
  import { initBtop } from '../scripts/btop';
  document.querySelectorAll<HTMLElement>('[data-btop]').forEach(initBtop);
</script>
